---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section id="prensa" class="py-32 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid lg:grid-cols-3 gap-16 mb-16">
      <div>
        <p class="text-accent text-xs font-semibold tracking-widest uppercase mb-3">04</p>
        <h2 class="text-3xl font-black">{t.press.title}</h2>
      </div>
      <div class="lg:col-span-2">
        <p class="text-muted leading-relaxed">{t.press.description}</p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      {t.press.items.map((item: { outlet: string; title: string }) => (
        <div class="group p-6 rounded-2xl bg-surface border border-white/5 hover:border-white/10 transition-all">
          <p class="text-accent text-xs font-semibold tracking-widest uppercase mb-3">{item.outlet}</p>
          <p class="text-sm text-white/80 leading-snug">"{item.title}"</p>
        </div>
      ))}
    </div>

  </div>
</section>
