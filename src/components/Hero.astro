---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="min-h-screen flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-6 py-24 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Text -->
      <div>
        <p class="text-muted text-sm font-medium tracking-widest uppercase mb-4">{t.hero.greeting}</p>
        <h1 class="text-5xl lg:text-6xl font-black tracking-tight leading-none mb-4">
          {t.hero.name}
        </h1>
        <p class="text-accent text-xl font-semibold mb-6">{t.hero.tagline}</p>
        <p class="text-muted leading-relaxed text-base max-w-lg mb-10">
          {t.hero.description}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#ponencias"
            class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-black text-sm font-bold rounded-full hover:bg-accent-dark transition-colors"
          >
            {t.hero.cta}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center px-6 py-3 border border-white/20 text-sm font-medium rounded-full hover:border-white/50 hover:text-white transition-all text-muted"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-6 mt-12 pt-12 border-t border-white/10">
          <a
            href="https://www.linkedin.com/in/jgbetanzos"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-white transition-colors text-sm font-medium"
          >
            LinkedIn →
          </a>
          <a
            href="https://www.runnea.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-white transition-colors text-sm font-medium"
          >
            Runnea →
          </a>
          <a
            href="https://runnea.academy"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-white transition-colors text-sm font-medium"
          >
            Academy →
          </a>
        </div>
      </div>

      <!-- Right side: stat cards -->
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2 p-6 rounded-2xl bg-surface border border-white/5">
          <p class="text-4xl font-black text-white">1.5M</p>
          <p class="text-muted text-sm mt-1">{t.lang === 'es' ? 'visitas mensuales' : 'monthly visits'}</p>
          <div class="mt-3 h-1 w-full bg-white/5 rounded-full">
            <div class="h-1 w-full bg-accent rounded-full"></div>
          </div>
          <p class="text-xs text-accent mt-2">100% {t.lang === 'es' ? 'orgánico' : 'organic'}</p>
        </div>
        <div class="p-5 rounded-2xl bg-surface border border-white/5">
          <p class="text-2xl font-black">210K</p>
          <p class="text-muted text-xs mt-1">YouTube</p>
        </div>
        <div class="p-5 rounded-2xl bg-surface border border-white/5">
          <p class="text-2xl font-black">155K</p>
          <p class="text-muted text-xs mt-1">Podcast</p>
        </div>
        <div class="p-5 rounded-2xl bg-surface border border-white/5">
          <p class="text-2xl font-black">+250K</p>
          <p class="text-muted text-xs mt-1">{t.lang === 'es' ? 'usuarios' : 'users'}</p>
        </div>
        <div class="p-5 rounded-2xl bg-surface border border-white/5">
          <p class="text-2xl font-black">5</p>
          <p class="text-muted text-xs mt-1">{t.lang === 'es' ? 'países' : 'countries'}</p>
        </div>
      </div>

    </div>
  </div>
</section>
